# Copy to .env (repo root for local, /opt/sspd/.env on the VPS).
# Never commit the real .env file. Replace CHANGE_ME / YOUR_* values.

# Spring profile: local=dev  |  Ubuntu VPS=prod
SPRING_PROFILES_ACTIVE=prod

# Database
DB_URL=jdbc:mysql://localhost:3306/ser_db?rewriteBatchedStatements=true&useServerPrepStmts=false
DB_USERNAME=YOUR_DB_USER
DB_PASSWORD=CHANGE_ME

# JWT — Base64 of at least 32 random bytes
JWT_SECRET=CHANGE_ME
JWT_EXPIRATION_MS=900000
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_DURATION_MINUTES=15

# Spring Boot TLS. Production must be false: Nginx terminates HTTPS.
SSL_ENABLED=false
SSL_KEYSTORE=
SSL_KEYSTORE_PASSWORD=
SSL_KEYSTORE_TYPE=PKCS12
SSL_KEY_ALIAS=servicemgmt

# Public URL (APK download links and similar)
APP_BASE_URL=https://your-domain.com

# Linux paths on the VPS
APP_APK_STORAGE_DIR=/opt/sspd/apk
BACKUP_ROOT_DIRECTORY=/opt/sspd/Backup
MYSQLDUMP_PATH=

# Browser origins allowed to call the API cross-origin (comma-separated).
# Same-origin via Nginx does not require this, but set it to your public HTTPS origin.
CORS_ALLOWED_ORIGINS=https://your-domain.com

# Bind address. Production should stay on localhost behind Nginx.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080

# Privileged SQL console (custom SELECT/INSERT/UPDATE/DELETE).
# Keep false. Set true only for a deliberate, time-limited administrative session.
ADMIN_QUERY_ENABLED=false
ADMIN_QUERY_MAX_ROWS=500
ADMIN_QUERY_TIMEOUT_SECONDS=30

# Customer password-reset emails (Gmail: smtp.gmail.com + app password)
# Optional fallback if Company Settings → Email (Gmail) is empty
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# Manual setup screen: generate a unique random value of at least 32 characters.
# Example: openssl rand -base64 32
SETUP_INITIAL_ADMIN_TOKEN=

# Optional standalone /scan device pairing secret (32+ random characters).
# Leave blank to require a logged-in staff account with sale-create permission.
SCANNER_PAIRING_TOKEN=

# Preferred production option: create the first admin at process startup.
# Enable for the first start only, then disable and remove the password.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Firebase FCM (server). Service-account private key JSON — not google-services.json.
# Project settings → Service accounts → Generate new private key
# Save as secrets/firebase-adminsdk.json (gitignored) or set an absolute path:
APP_FCM_CREDENTIALS_FILE=./secrets/firebase-adminsdk.json
APP_FCM_CREDENTIALS_BASE64=
# Technician Android app uses a separate Firebase project (sspd-technician). Download that
# project's service-account private key (not google-services.json) and point this at it:
APP_FCM_TECHNICIAN_CREDENTIALS_FILE=./secrets/firebase-technician-adminsdk.json
APP_FCM_TECHNICIAN_CREDENTIALS_BASE64=

# Backblaze B2 private product videos (server only — never put these in the customer app).
# Bucket: sspd-storage. Link products by object key, e.g. products/example-video.mp4
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=sspd-storage
B2_BUCKET_ID=
