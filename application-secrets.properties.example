# Copy this file to application-secrets.properties in the repository root.
# The copied file is ignored by Git. Never commit real values.

spring.datasource.password=REPLACE_WITH_DATABASE_PASSWORD

# Base64-encoded value generated from at least 32 random bytes.
application.security.jwt.secret-key=REPLACE_WITH_BASE64_JWT_SECRET

server.ssl.key-store-password=REPLACE_WITH_KEYSTORE_PASSWORD

# Enable only for the first startup of a new database, then disable it.
app.bootstrap-admin.enabled=false
app.bootstrap-admin.email=
app.bootstrap-admin.username=
app.bootstrap-admin.password=
