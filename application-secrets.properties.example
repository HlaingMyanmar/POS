# Copy this file to application-secrets.properties in the repository root (local Windows)
# or /opt/sspd/application-secrets.properties on the VPS.
# Git ignores the copied file. Never commit real values.
#
# You can use either environment-style keys (recommended) or Spring property names.

DB_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME
SSL_ENABLED=false
SSL_KEYSTORE_PASSWORD=

APP_BASE_URL=http://localhost:8080
APP_APK_STORAGE_DIR=./apk-storage
BACKUP_ROOT_DIRECTORY=./Backup
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080

BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
