<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Android system default TLS validation:
        valid / not expired / trusted CA / hostname match / certificate chain.
        Example: https://sspdmyanmar.com requires a cert for sspdmyanmar.com.
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
